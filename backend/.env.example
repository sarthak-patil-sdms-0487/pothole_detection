# Database Configuration (SQLite for local testing or PostgreSQL)
DATABASE_URL=sqlite:///./potholes.db
# DATABASE_URL=postgresql://user:password@localhost:5432/pothole_db

# Google Gemini API Key (Optional — only needed for the Gemini detection method.
# The YOLO detection path and the rest of the API run without it.)
GEMINI_API_KEY=your_gemini_api_key_here

# Contractor notice dispatch. False keeps statutory notices in simulated mode
# (generated and audit-logged, but not delivered).
NOTIFY_CONTRACTORS_LIVE=False

# Object Storage for image uploads (MinIO by default — S3-compatible and free
# to self-host). Leave S3_ENDPOINT_URL blank to talk to real AWS S3 instead.
# If all three of the key/secret/bucket values are blank, uploads fall back to
# returning inline base64 data URIs and nothing is stored.
S3_ENDPOINT_URL=http://localhost:9000
# Browser-facing URL, if it differs from the endpoint the API dials
# (e.g. inside Docker the API uses http://minio:9000 but the browser needs localhost).
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=pothole-images

# Contractor complaint delivery.
# While testing, every notice is addressed here instead of the real contractor.
# Clear this to address notices to the contractor on the governing tender.
NOTICE_RECIPIENT_OVERRIDE=your_test_inbox@example.com

# SMTP for actually delivering the complaint. With SMTP_HOST blank the notice is
# generated and audit-logged but NOT delivered, and reports status SIMULATED.
# Gmail: use an App Password (not your normal password) with 2FA enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_gmail_address@gmail.com
SMTP_USE_TLS=true
