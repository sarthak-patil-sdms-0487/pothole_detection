# Database Configuration (SQLite for local testing or PostgreSQL)
DATABASE_URL=sqlite:///./potholes.db
# DATABASE_URL=postgresql://user:password@localhost:5432/pothole_db

# Google Gemini API Key (Required for LLM pothole detection & analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# AWS S3 Storage Configuration (Optional, for storing image uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name
