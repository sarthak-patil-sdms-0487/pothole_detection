# Container credentials for docker-compose (copy to .env and set strong values).
# docker compose auto-loads .env from this directory. Keep in sync with
# backend/.env (DATABASE_URL password, S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=midc_pothole
MINIO_ROOT_USER=change_me_minio_user
MINIO_ROOT_PASSWORD=change_me_to_a_strong_password
